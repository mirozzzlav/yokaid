FROM golang:1.21
WORKDIR /app

ARG LOGS_TO_SCREEN
ARG LOGS_TO_FILE
ARG SUPPORT_MAIL
ARG APP_NAME
ARG MAIL_FROM
ARG SEND_SMS_URL
ARG SEND_SMS_AUTH
ARG SEND_MAIL_URL
ARG SEND_MAIL_AUTH

ENV LOGS_TO_SCREEN=${LOGS_TO_SCREEN}
ENV LOGS_TO_FILE=${LOGS_TO_FILE}
ENV SUPPORT_MAIL=${SUPPORT_MAIL}
ENV APP_NAME=${APP_NAME}
ENV MAIL_FROM=${MAIL_FROM}
ENV SEND_SMS_URL=${SEND_SMS_URL}
ENV SEND_SMS_AUTH=${SEND_SMS_AUTH}
ENV SEND_MAIL_URL=${SEND_MAIL_URL}
ENV SEND_MAIL_AUTH=${SEND_MAIL_AUTH}

COPY go.mod go.sum ./
RUN go mod download && go mod verify

COPY ./ ./
RUN go build -v -o /usr/local/bin/app

RUN mkdir -p ./logs && chmod -R 777 ./logs

CMD ["app"]